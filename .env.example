# =============================================================================
# ResourceFlow – Environment Variable Template
# Optional local configuration: copy this file to backend/.env and fill values.
# NEVER commit your .env file. It is listed in .gitignore.
# =============================================================================

# Node
NODE_ENV=development
PORT=5000

# MongoDB
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resourceflow?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/resourceflow
# RS:     mongodb://localhost:27017/resourceflow?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/resourceflow
MONGODB_TEST_URI=mongodb://localhost:27017/resourceflow_test

# JWT  (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_BYTE_HEX_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Bcrypt
BCRYPT_ROUNDS=12

# Seed options (automatic only when SEED_DEMO_DATA=true and the database is empty)
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@resourceflow.dev
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SEED_DEMO_DATA=false
